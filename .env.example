# Copie este archivo como .env y cambie los valores: cp .env.example .env
# (.env no se sube al repositorio: está en .gitignore)

# Puerto del computador donde se publica la app (http://localhost:PUERTO)
PUERTO=8080

# Credenciales de la base H2 en archivo (se fijan la primera vez que se crea el volumen)
BD_USUARIO=orderflow
BD_CLAVE=cambie-esta-clave

# Restaurante
ORDERFLOW_MESAS=10
ORDERFLOW_DEMO_HISTORICO=true
