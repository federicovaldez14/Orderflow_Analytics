# Copie este archivo como .env y cambie TODAS las claves: cp .env.example .env
# (.env no se sube al repositorio: está en .gitignore)
# Para generar una clave segura: openssl rand -base64 24

# Puerto del computador donde se publica la app (http://localhost:PUERTO)
PUERTO=8080

# --- Base de datos PostgreSQL (servicio db) ---
POSTGRES_DB=orderflow
POSTGRES_USER=orderflow
POSTGRES_PASSWORD=cambie-esta-clave-de-base

# --- Primer administrador de la aplicación (se crea si no existe ninguno) ---
ORDERFLOW_ADMIN_USUARIO=admin
# Mínimo 12 caracteres
ORDERFLOW_ADMIN_CLAVE=cambie-esta-clave-de-admin

# --- Restaurante ---
ORDERFLOW_MESAS=10
# Carga ~7 días de pedidos de ejemplo la primera vez (para ver la analítica)
ORDERFLOW_DEMO_HISTORICO=true

# --- Observabilidad (solo con: docker compose --profile observabilidad up -d) ---
# Usuario de solo lectura de métricas con el que Prometheus consulta la app (mínimo 12 caracteres)
ORDERFLOW_MONITOR_USUARIO=prometheus
ORDERFLOW_MONITOR_CLAVE=cambie-esta-clave-de-monitor
GRAFANA_USUARIO=admin
GRAFANA_CLAVE=cambie-esta-clave-de-grafana
